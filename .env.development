# Development Environment Variables
# This file is loaded when DEV_MODE=true

# Frontend API configuration for development
REACT_APP_API_BASE_URL=http://localhost:8000/api

# Development specific settings
DEV_MODE=true

# MongoDB credentials
MONGO_USERNAME=root
MONGO_PASSWORD=nycuee
# Frontend API configuration for production build
REACT_APP_API_BASE_URL_PROD=/api

FRONTEND_PORT=3000

# 身份驗證（backend/auth.py）
# AUTH_SECRET 是簽存取權杖的秘鑰。**沒設的話後端啟動時會臨時產生一把並印出警告**，
# 開發環境可以不設，但每次重啟大家都要重新登入。正式環境務必設一個夠長的隨機字串：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 刻意不給寫死的預設值——那種預設值會原封不動地上正式環境，而且因為「它能動」
# 所以沒有人會發現。
AUTH_SECRET=
# 權杖有效期（小時），預設 12
AUTH_TOKEN_TTL_HOURS=12

# CORS 允許的來源，逗號分隔。留空 = 用 backend/main.py 裡的 DEFAULT_ORIGINS
# （原本那份寫死的清單），所以不設也不會壞。換部署位置時改這裡就好。
CORS_ORIGINS=

# 建立帳號的邀請碼（backend/main.py 的 /api/register）
# 留空 = 開放註冊，任何知道網址的人都能開帳號。
# 部署在公開位置時建議設一組——讀取端點大多是公開的，所以多一個帳號洩漏不了
# 東西，但有人可以無限開帳號並上傳光表佔掉資料庫。
REGISTER_CODE=
